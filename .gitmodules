[submodule "contrib/web/offline-mail-forwarding"]
	path = dev/contrib/offline-mail-forwarding
	url = https://github.com/GuduleLapointe/offline-mail-forwarding
[submodule "contrib/drupal/d4os"]
	path = dev/contrib/drupal/d4os
	url = https://git.drupalcode.org/project/d4os.git
	branch = 7.x-1.x
[submodule "contrib/wordpress/w4os"]
	path = dev/contrib/w4os
	url = https://github.com/GuduleLapointe/w4os/
[submodule "contrib/currency/Gloebit"]
	path = contrib/Gloebit/src
	url = https://github.com/gloebit/opensim-moneymodule-gloebit.git
[submodule "webtools/currency-omc/helper/phpxmlrpc"]
	path = dev/contrib/currency-omc/helper/phpxmlrpc
	url = https://github.com/gggeek/phpxmlrpc.git
[submodule "contrib/OpenSimSearch"]
	path = contrib/OpenSimSearch/src
	url = https://github.com/kcozens/OpenSimSearch
[submodule "upstream/opensim"]
	path = upstream/opensim
	url = https://github.com/opensim/opensim.git
	branch = master
	shallow = true
[submodule "modules/OpenSimSearch"]
	path = modules/OpenSimSearch
	url = https://github.com/GuduleLapointe/OpenSimSearch.git
