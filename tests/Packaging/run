#!/usr/bin/env bash
# Tests the packages of dist/ in a container with systemd (podman): install,
# .NET runtime, a grid made by the wizard, service start, upgrade, removal
# and purge. Exits non-zero when a check fails.
#
# Usage, from the repository root, after building the packages:
#   tests/Packaging/run [base image]
#   e.g. tests/Packaging/run docker.io/library/ubuntu:24.04
# KEEP=1 keeps the container for inspection, SCENARIO=web-scenario.sh runs another script of this folder, STOP_AFTER=search
# ends scenario.sh after the search tests (search.sh).
# The packages of the libraries the tools depend on are taken from the dist folders of their projects (DEPS_ENGINE,
# DEPS_REST and DEPS_HELPERS say where they are). What the container needs is sent to it as a tar stream, so it can run
# on any machine: CONTAINER_CONNECTION=name (see podman system connection) uses the podman of another one; it and MEMORY
# can be set in tests/.env (see tests/.env.example), after the .env of the project.

set -eo pipefail

BASE=${1:-docker.io/library/debian:bookworm}
TEST_DIR=tests/Packaging
name=opensim-kit-test-$(basename "$BASE" | tr ':.' '--')

cd "$(git rev-parse --show-toplevel)"
BASE_DIR=$PWD
[[ -f vendor/bin/bash-helpers ]] || { echo "bash-tools is not installed: composer install" >&2; exit 1; }
source vendor/bin/bash-helpers

# The environment of the project (.env) and the one of the tests (tests/.env): CONTAINER_CONNECTION, MEMORY...
ENV_SLUG=tests read_env || true
[[ -z "${CONTAINER_CONNECTION:-}" ]] || log "Podman connection: $CONTAINER_CONNECTION"

# The packages to install: those of dist/ and those of the libraries
for dir in dist "${DEPS_ENGINE:-../opensim-engine/dist}" "${DEPS_REST:-../opensim-rest-php/dist}" "${DEPS_HELPERS:-../opensim-helpers/dist}"; do
    if ! ls "$dir"/*.deb >/dev/null 2>&1; then
        die "no Debian package in $dir: build it first (dev/build.sh in that project)"
    fi
done

podman build -q -t "$name" --build-arg BASE="$BASE" "$TEST_DIR" >/dev/null
# The machine of podman is shared with every other container: say so when it
# lacks the memory the test may use, before it stops a container of another project
available=$(podman run --rm --pull=never --entrypoint awk "$name" '/MemAvailable/ {print int($2 / 1024)}' /proc/meminfo 2>/dev/null || true)
if [[ "${available:-0}" -gt 0 && "${available:-0}" -lt 800 ]]; then
    warning "Only ${available} MB of memory are available in the machine of podman: stop the containers you do not need first, or the test may make it stop one of them (see DEVELOPERS.md)."
fi
podman rm -f "$name" >/dev/null 2>&1 || true
# The memory is capped: a machine that lacks memory stops the biggest process
# of any container, so the test must not reach that limit outside its own
podman run -d --name "$name" --systemd=always --memory="${MEMORY:-700m}" "$name" >/dev/null
stage=$(mktemp -d)
cleanup() {
    rm -rf "$stage"
    [[ -n "${KEEP:-}" ]] || podman rm -f "$name" >/dev/null
}
trap cleanup EXIT
sleep 3

# The packages for the architecture of the container (and the ones for all), and the test scripts
arch=$(podman exec "$name" dpkg --print-architecture)
mkdir "$stage/dist" "$stage/test"
for dir in dist "${DEPS_ENGINE:-../opensim-engine/dist}" "${DEPS_REST:-../opensim-rest-php/dist}" "${DEPS_HELPERS:-../opensim-helpers/dist}"; do
    for deb in "$dir"/*_all.deb "$dir"/*_"$arch".deb; do
        [[ ! -e "$deb" ]] || ln -sf "$(cd "$(dirname "$deb")" && pwd)/$(basename "$deb")" "$stage/dist/"
    done
done
for file in "$TEST_DIR"/*; do
    ln -s "$PWD/$file" "$stage/test/"
done
COPYFILE_DISABLE=1 tar -chf - -C "$stage" dist test | podman exec -i "$name" tar -xf - --no-same-owner --warning=no-unknown-keyword -C /
podman exec ${STOP_AFTER:+-e STOP_AFTER="$STOP_AFTER"} "$name" bash "/test/${SCENARIO:-scenario.sh}"
